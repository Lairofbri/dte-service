# =============================================
# DTE SERVICE — Variables de entorno
# Una instancia = un cliente (un NIT)
#
# IMPORTANTE: Los datos del emisor (NIT, nombre, credenciales de Hacienda)
# se configuran desde el frontend en /configuracion
# NO van en este archivo — la BD es la única fuente de verdad
# Esto permite vender el servicio a múltiples clientes
# sin cambiar el código
# =============================================

# Servidor
NODE_ENV=development
PORT=4000

# Base de datos PostgreSQL (Docker local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dte_service
# Railway PostgreSQL usa un certificado autofirmado en su proxy:
# en producción con Railway debe ser `false` (SELF_SIGNED_CERT_IN_CHAIN).
DB_SSL_REJECT_UNAUTHORIZED=false

# Seguridad
API_KEY_HASH=hash_bcrypt_de_la_api_key
ENCRYPTION_KEY=clave_de_32_caracteres_exactos_aqui
JWT_SECRET=secreto_de_minimo_64_bytes_en_hex
JWT_EXPIRA_EN=8h
JWT_REFRESH_EXPIRA_EN=7d

# Hacienda — solo URLs, datos del emisor van en BD
AMBIENTE_HACIENDA=00
URL_AUTH_HACIENDA=https://apitest.dtes.mh.gob.sv/seguridad/auth
URL_RECEPCION_HACIENDA=https://apitest.dtes.mh.gob.sv/fesv/recepciondte
URL_CONSULTA_HACIENDA=https://apitest.dtes.mh.gob.sv/fesv/recepcion/consultadte/
URL_CONTINGENCIA_HACIENDA=https://apitest.dtes.mh.gob.sv/fesv/contingencia
URL_ANULACION_HACIENDA=https://apitest.dtes.mh.gob.sv/fesv/anulardte
TIMEOUT_HACIENDA=8000
MAX_REINTENTOS_HACIENDA=2

# Firmador
# Decisión 2026-09-26: se usa el firmador remoto (cuscatec) en lugar del local.
# Requiere que el certificado del NIT esté cargado en el firmador remoto y
# FIRMADOR_PASSWORD_PRI_<tenant_id> (o global FIRMADOR_PASSWORD_PRI) para firmar.
URL_FIRMADOR=https://firmador.cuscatec.com/firmardocumento/
TIMEOUT_FIRMADOR=10000
FIRMADOR_API_KEY=
# Token Bearer del firmador remoto (Authorization: Bearer <token>).
# Lo comparte el operador del servicio de firma (rota cada 24h).
FIRMADOR_TOKEN=
# Contraseña de la llave privada del certificado de firma (passwordPri).
# Por tenant: FIRMADOR_PASSWORD_PRI_<tenant_id> (Secret Manager en producción).
FIRMADOR_PASSWORD_PRI=

# CORS
CORS_ORIGINS=http://localhost:5173

# Provisión interna POS ↔ DTE (Fase 2)
# Clave interna servidor-a-servidor para /internal/provisioning/*
# (DISTINTA de la API Key técnica del POS). Sin ella las rutas internas
# devuelven 503 (fail-closed).
INTERNAL_API_KEY=clave_interna_distinta_de_la_api_key_del_pos
# URL y clave de salida del outbox hacia el POS. Sin URL, el worker no corre.
POS_PROVISIONING_URL=http://localhost:3000
POS_PROVISIONING_API_KEY=clave_interna_del_pos_para_recibir_eventos

# Logs
LOG_LEVEL=info
